{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "passport-ai-whatsapp",
  "compatibility_date": "2026-08-11",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "passport-ai-production",
      "database_id": "d233b7ec-fa6c-484c-afa0-b183b67df58d"
    }
  ]
  // R2 bucket not currently used by the code (no binding referenced in src/).
  // Re-add here once the Cloudflare API token has R2 permissions if file storage is needed:
  // "r2_buckets": [
  //   { "binding": "PASSPORTS_BUCKET", "bucket_name": "passport-ai-images" }
  // ]
  //
  // Secrets to set with `wrangler pages secret put <NAME>` before production deploy:
  //   GEMINI_API_KEY        -> Google AI Studio Gemini API key
  //   JWT_SECRET            -> random long string for signing session tokens
  //   WHATSAPP_VERIFY_TOKEN -> token you choose, must match Meta App webhook config
  //   WHATSAPP_API_VERSION  -> e.g. v21.0 (optional, defaults to v21.0)
  //   BRIDGE_SECRET         -> shared secret for the Baileys WhatsApp-group bridge (VPS)
  //   VISA_CHECKER_SECRET   -> shared secret for the VPS periodic Umrah-visa checker
}
